#
# K434/K431 fixture: the `server` profile has no consd. The identity shell opens `tty:console`, so
# the static test image stages consd to provide the scheme. Test-only.

name = "consd"
exec = "/sbin/consd"
needs = ["logd"]
provides = ["scheme:tty"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
