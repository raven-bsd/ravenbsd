# One-shot probe: verify the driver's partition and data patterns through `disk:0`, then flush to
# end the first launch. It stays alive until devd has finished the second launch.
name = "s205-probe"
exec = "/sbin/s205-probe"
args = ["s205-probe"]
needs = ["scheme:disk"]
readiness = "exit"
restart = "never"
max_restarts = 0
