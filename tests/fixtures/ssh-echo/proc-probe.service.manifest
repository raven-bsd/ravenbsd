#
# K434 rev207 test-only process-state scanner. Runs from svcd so the shell/sshd spawn hang cannot
# block the probe; prints the K391 state/last syscall of syscall-blocked or ssh processes.

name = "proc-probe"
exec = "/bin/proc-probe"
args = ["/bin/proc-probe", "--scan"]
needs = ["scheme:net"]
readiness = "none"
restart = "never"
max_restarts = 0
required = false
