# The test instance runs the matched driver for two launch/exit cycles and exits when done.
# `scheme:nic` is devd's readiness gate, so svcd starts the ring probe only after the driver has
# registered `nic:`. `platform-root` is the only device grant the init policy allows for `devd`;
# it lands at handle 3 so devd can create an MSI-X vector per function instead of falling back to
# a shared legacy INTx line.
name = "devd"
exec = "/sbin/devd"
args = ["devd", "test"]
needs = ["scheme:pci"]
provides = ["scheme:nic", "scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
grants = ["platform-root"]
