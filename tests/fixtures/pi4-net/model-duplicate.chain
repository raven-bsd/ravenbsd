#
# Negative model: devd launches GENET and svcd also has an enabled genet
# service. The checker must reject this chain.
devd_args=dtb,launch
genet_driver=slots=platform
genet_launchers=2
netd_needs=scheme:nic
dtb_staged=yes
drivers_staged=yes
