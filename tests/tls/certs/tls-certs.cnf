#
# Test CA used by tests/tls/certs/make-test-ca.sh. The primary CA and server
# certificate are issued with a 1970-2049 validity window because the guest
# realtime clock is zero until an RTC source is wired into the kernel.

[ ca ]
default_ca = CA_default

[ CA_default ]
dir = ./build/tls/certs/test/pki
database = $dir/index.txt
new_certs_dir = $dir/newcerts
certificate = $dir/ca.pem
serial = $dir/serial
private_key = $dir/ca.key
default_md = sha256
default_days = 365
policy = policy_any
unique_subject = no
copy_extensions = none
email_in_dn = no
rand_serial = no

[ policy_any ]
commonName = optional
countryName = optional
stateOrProvinceName = optional
localityName = optional
organizationName = optional
organizationalUnitName = optional
emailAddress = optional

[ req ]
distinguished_name = req_dn
prompt = no

[ req_dn ]
CN = RavenBSD T3 test

[ ca_ext ]
basicConstraints = critical,CA:TRUE
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash

[ server_ext ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = IP:10.0.2.2
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
