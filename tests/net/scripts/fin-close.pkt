// B18: orderly close: FIN from the SUT, ACK and FIN from the peer, final ACK.

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 1) = 0

+0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,nop,nop,sackOK,nop,wscale 7>
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 accept(3, ..., ...) = 4

// close() sends FIN, which consumes one sequence number.
+0.100 close(4) = 0
+0.000 > F. 1:1(0) ack 1

+0.100 < . 1:1(0) ack 2 win 65535
+0.100 < F. 1:1(0) ack 2 win 65535
+0.000 > . 2:2(0) ack 2
