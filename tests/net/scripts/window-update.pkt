// B18: a zero window holds data back; the window update releases queued data.

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 1) = 0

+0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,nop,nop,sackOK,nop,wscale 7>
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 accept(3, ..., ...) = 4

// Advertise a zero window, queue 20 bytes, and verify nothing is sent yet.
+0.100 < . 1:1(0) ack 1 win 0
+0.000 write(4, ..., 20) = 20
+0.050 read(4, ..., 1) = -1 EAGAIN (Resource temporarily unavailable)

// Open the window again: the queued payload must now be transmitted.
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 > P. 1:21(20) ack 1
+0.100 < . 21:21(0) ack 21 win 65535

+0.000 close(4) = 0
