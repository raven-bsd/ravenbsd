// B18: data in both directions with ACKs.

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 1) = 0

+0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,nop,nop,sackOK,nop,wscale 7>
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 accept(3, ..., ...) = 4

// Peer sends 10 bytes; the SUT ACKs and read() returns the payload.
+0.100 < P. 1:11(10) ack 1 win 65535
+0.000 > . 1:1(0) ack 11
+0.000 read(4, ..., 10) = 10

// The SUT sends 10 bytes; the peer ACKs them.
+0.000 write(4, ..., 10) = 10
+0.000 > P. 1:11(10) ack 11
+0.100 < . 11:11(0) ack 11 win 65535

+0.000 close(4) = 0
