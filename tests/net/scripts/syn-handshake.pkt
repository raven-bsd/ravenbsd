// B18: three-way handshake on a listening TCP socket.
// Hand-written for this harness; not copied from packetdrill's test suite.

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 1) = 0

// Peer SYN (relative sequence 0); the SUT must answer SYN-ACK with ISN+1 acked.
+0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,nop,nop,sackOK,nop,wscale 7>

// Complete the handshake and accept the connection.
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 accept(3, ..., ...) = 4
+0.000 close(4) = 0
