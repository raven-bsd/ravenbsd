// B18: an in-window RST tears the connection down.

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 1) = 0

+0.100 < S 0:0(0) win 65535 <mss 1460,sackOK,nop,nop,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,nop,nop,sackOK,nop,wscale 7>
+0.100 < . 1:1(0) ack 1 win 65535
+0.000 accept(3, ..., ...) = 4

// Reset from the peer; the socket must become unusable.
+0.100 < R 1:1(0) win 0
+0.000 write(4, ..., 10) = -1 ENOTCONN (Transport endpoint is not connected)
+0.000 close(4) = 0
