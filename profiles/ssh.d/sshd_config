# OpenSSH server policy for the root-only 0.1.0 demo. Host keys are generated on first start
# (see ssh-firstboot); they are not shipped in the image.

Port 22
ListenAddress 0.0.0.0
PidFile /tmp/sshd.pid
HostKey /tmp/ssh/ssh_host_rsa_key
HostKey /tmp/ssh/ssh_host_ecdsa_key
HostKey /tmp/ssh/ssh_host_ed25519_key
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
UsePAM no
AuthorizedKeysFile none
StrictModes no
PrintMotd no
UseDNS no
LogLevel VERBOSE
Subsystem sftp internal-sftp
