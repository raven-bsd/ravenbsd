# The second boot's only guest marker; the real assertion in this case is the host-side
# artifact check in the case pre step.
name = "hw-net-verify"
exec = "/bin/echo"
args = ["hw-net: verify boot"]
readiness = "exit"
restart = "never"
max_restarts = 0
