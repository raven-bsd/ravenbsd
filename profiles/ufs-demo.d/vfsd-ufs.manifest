# vfsd snapshots the visible scheme names at process creation, so fsd-ufs must
# register ufs: before this service starts. The base release vfsd is disabled in
# rc.conf; this service is the only file: provider.
name = "vfsd-ufs"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd", "nulld", "zerod", "randd", "scheme:ufs"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
