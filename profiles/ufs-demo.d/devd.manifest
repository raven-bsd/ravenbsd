# devd launches every matched virtio function in one pass. MSI-X needs the devd-only
# `platform-root` capability (ADMIN on the root device) so devd can create one vector per
# function; the grant lands at handle 3. blockd consumes disk:; the network services stay
# disabled in this demo and are started explicitly by the multi-driver qtest.
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:disk", "scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
grants = ["platform-root"]
