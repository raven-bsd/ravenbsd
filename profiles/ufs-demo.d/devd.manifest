# devd launches the matched virtio-blk function in production mode. blockd
# depends on the disk: scheme; the network services are staged but disabled in
# this storage demo (release-login is the network gate).
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:disk", "scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
