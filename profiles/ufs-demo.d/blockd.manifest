# blockd over the virtio-blk driver's disk:0. The remote backend reads the GPT
# prefix and serves partition 1 to fsd-ufs.
name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0

[env]
BLOCKD_DISK = "disk:0"
