# One getty on the console. The demo vfsd is named vfsd-ufs so the base release
# vfsd can stay disabled; this service is ordered after the UFS-aware one.
name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd-ufs", "ramfsd", "initfsd"]
restart = "never"
max_restarts = 0
grants = ["initfs"]
