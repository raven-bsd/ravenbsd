# The server image needs only the schemes required for `/` and the writable
# `/etc` where resolvd publishes the lease-derived resolv.conf.
name = "vfsd"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
