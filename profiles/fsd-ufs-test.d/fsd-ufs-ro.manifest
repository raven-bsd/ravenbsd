# K54 read-only integration manifest.
name = "fsd-ufs"
exec = "/sbin/fsd-ufs"
needs = ["scheme:block"]
provides = ["scheme:ufs"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "on-failure"

[env]
FSD_UFS_DEVICE = "block:0"
FSD_UFS_PARTITION = "1"
FSD_UFS_SCHEME = "ufs"
FSD_UFS_READ_ONLY = "1"
