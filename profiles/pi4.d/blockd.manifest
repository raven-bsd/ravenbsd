# blockd over the EMMC2 driver's `disk:0`. The GPT scan reads the 1 MiB prefix; the Pi image's
# ROOT partition is the same GPT partition the generic image path builds.
name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
# Staged with emmc2; turn on when the EMMC2 driver program is in the Pi initfs.
enable = false

[env]
BLOCKD_DISK = "disk:0"
