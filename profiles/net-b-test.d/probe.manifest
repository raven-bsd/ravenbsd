# One-shot probe: map the ring, exchange one ARP frame per devd cycle, then exit.
name = "net-b-probe"
exec = "/sbin/net-b-probe"
args = ["net-b-probe"]
needs = ["scheme:nic"]
readiness = "exit"
restart = "never"
max_restarts = 0
