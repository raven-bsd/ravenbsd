# Pi 4 platform launch (P8/P12): match the DTB, grant the platform driver
# handles and spawn the matched drivers. platd and genet are launched here, not
# by svcd. The P8b multi-window launcher is still required for platd's four
# handles; no board result is claimed before it lands.
name = "devd"
exec = "/sbin/devd"
args = ["devd", "dtb", "launch"]
needs = ["logd", "vfsd", "initfsd"]
provides = ["scheme:plat", "scheme:dev", "scheme:nic"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "on-failure"
grants = ["platform-root"]
