# Pi 4 device manager. The DTB match path exists, but the platform launch that
# grants MMIO/DMA/IRQ handles and spawns /sbin/genet is P8; staging the service
# disabled avoids claiming a driver launch that is not wired yet.
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "on-failure"
enable = false
