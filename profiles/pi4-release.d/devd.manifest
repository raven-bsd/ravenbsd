# Pi 4 platform launch (P8): match the DTB, grant BAR/DMA/IRQ handles and
# spawn the matched platform drivers. The child `nic:`/`dev:` schemes are the
# readiness gate; the init root grant for devd is P10 (Kevin).
name = "devd"
exec = "/sbin/devd"
args = ["devd", "dtb", "launch"]
grants = ["platform-root"]
needs = ["logd", "vfsd", "initfsd"]
# devd launches the platform drivers and waits for them; it does not serve a scheme
# of its own. netd waits for the child genet's `scheme:nic` instead.
readiness = "none"
ready_timeout_ms = 60_000
restart = "on-failure"
