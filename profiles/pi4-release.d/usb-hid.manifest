# S62 keyboard console queue exposed as `kbd:`. The xHCI driver pushes ASCII bytes; CON1 can
# drain them without a shared-memory side channel. An empty queue is not a boot dependency:
# UART getty/login stays independent and a missing keyboard leaves `READ` on EAGAIN.
name = "usb-hid"
exec = "/sbin/usb-hid"
provides = ["scheme:kbd"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
enable = true
required = false
