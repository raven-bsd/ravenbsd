# REL1c getty service. The image builder now maps the `raven-getty` package to
# its `getty` binary, so the service is enabled and login is the release prompt.
name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd", "ramfsd", "initfsd"]
restart = "on-failure"
grants = ["initfs"]
