# REL1c getty service, staged disabled until the `raven-getty` package can be
# staged by its binary name (`getty`) through the image builder. The release
# login account files and /bin/login are present; enable this when the getty
# packaging follow-up lands.
name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd", "ramfsd", "initfsd"]
restart = "on-failure"
grants = ["initfs"]
enable = false
