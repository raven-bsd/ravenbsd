# Pi 4 platform server. It needs the mailbox/GPIO/RNG/DMA handles from the
# platform launcher (P8); staging it disabled keeps svcd from starting a server
# without those grants. The service will be enabled with the P8 launch.
name = "platd"
exec = "/sbin/platd"
restart = "never"
max_restarts = 0
enable = false
