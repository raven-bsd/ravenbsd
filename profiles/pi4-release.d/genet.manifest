# Pi 4 GENET frame service (REL4/P8). devd supplies the platform BAR/DMA/IRQ
# handles and platd supplies the MAC; the driver serves `nic:`. The board
# link/DHCP/ping result stays UNVERIFIED until the owner log.
name = "genet"
exec = "/sbin/genet"
needs = ["logd", "scheme:plat"]
provides = ["scheme:nic"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
# devd (P8/P10) spawns /sbin/genet with its platform grants; this entry documents the
# scheme and must not start a second instance.
enable = false
