# Pi 4 E-Ink demo service. It is ordered after getty and the network/resolver/platform schemes so
# no panel access happens on the boot/getty path. It remains disabled by default: the launch path
# must supply the SPI0 MMIO handle and platd must gain a DC/RST level call before the panel can be
# driven (see docs/eink-demo.md). Once that wiring exists, enable this profile entry.
name = "einkd"
exec = "/sbin/einkd"
args = ["einkd", "--config=/etc/einkd.conf"]
needs = ["getty", "scheme:net", "scheme:resolv", "scheme:plat"]
readiness = "none"
restart = "on-failure"
max_restarts = 3
required = false
enable = false
