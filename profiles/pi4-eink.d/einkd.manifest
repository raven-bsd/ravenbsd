# Pi 4 E-Ink dry-run service. E1e stages the BSP binary but keeps panel/network access off
# until E4: the service is disabled by default and runs only the static dry-run/once path when
# started explicitly. It is ordered after getty so it can never run on the boot/getty path; the
# dry-run mode needs no network, and the real `--config` mode returns the hardware-not-built
# error until E4 supplies the SPI/GPIO adapter.
name = "einkd"
exec = "/sbin/einkd"
args = ["einkd", "--dry-run", "--once"]
needs = ["getty"]
readiness = "none"
restart = "never"
max_restarts = 0
required = false
enable = false
