# Pi 4 E-Ink demo service. It is ordered after getty and the network/resolver/platform/SPI
# schemes so no panel access happens on the boot/getty path. The panel BUSY wait stays here, not
# in platd. `spi0d` is launched by devd and publishes `spi:`; `platd` drives DC/RST/BUSY.
name = "einkd"
exec = "/sbin/einkd"
args = ["einkd", "--config=/etc/einkd.conf"]
needs = ["getty", "scheme:net", "scheme:resolv", "scheme:plat", "scheme:spi"]
readiness = "none"
restart = "on-failure"
max_restarts = 3
required = false
enable = true
