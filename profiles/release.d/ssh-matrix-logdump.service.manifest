#
# K434 S3 server-log evidence. One-shot after boot; `cat` is an rsh builtin and /bin/sleep is
# staged by the shell profile. The log goes to the serial console (tty:console), not to a file the
# unprivileged lane cannot read.

name = "ssh-matrix-logdump"
exec = "/bin/rsh"
args = ["/bin/rsh", "-c", "sleep 20; cat /tmp/sshd.log > tty:console; sleep 20; cat /tmp/sshd.log > tty:console; sleep 20; cat /tmp/sshd.log > tty:console; sleep 20; cat /tmp/sshd.log > tty:console; sleep 20; cat /tmp/sshd.log > tty:console"]
needs = ["vfsd"]
readiness = "exit"
restart = "never"
max_restarts = 0
required = false
