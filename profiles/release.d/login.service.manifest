#
# One getty on the console. It needs the tty scheme from consd and the initfs for /bin/login and
# the account files; all of those are staged in the initfs, so login does not wait for the
# ramfs/vfs or network services. This keeps getty ahead of netd/resolvd in the start plan.

name = "getty"
exec = "/bin/getty"
needs = ["consd", "initfsd"]
restart = "on-failure"
grants = ["initfs"]
