#
# One getty on the console. It needs the tty scheme from consd and the file namespace for the
# dynamic loader, /bin/login and the account files. The network is deliberately not in these
# dependencies; the release netd manifest starts after getty instead.

name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd", "ramfsd", "initfsd"]
restart = "on-failure"
grants = ["initfs"]
