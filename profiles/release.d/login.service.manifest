#
# One getty on the console. It needs the tty scheme from consd and the
# initfs/ramfs/vfs services for the account files and /bin/login.

name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd", "ramfsd", "initfsd", "scheme:net"]
restart = "on-failure"
grants = ["initfs"]
