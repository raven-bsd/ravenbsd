# x86_64 release: the PCI enumerator owns the root grant and serves `pci:`.
name = "pcid"
exec = "/sbin/pcid"
provides = ["scheme:pci"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "on-failure"
grants = ["root"]
