# The one-shot listing runs in the wave after devd, so `devd stopped 0` is deterministic.
name = "svcctl-list"
exec = "/bin/svcctl"
args = ["svcctl", "list"]
needs = ["devd"]
readiness = "exit"
restart = "never"
max_restarts = 0
