# The test instance runs the matched driver for ten launch/exit cycles and exits when done.
name = "devd"
exec = "/sbin/devd"
args = ["devd", "test"]
needs = ["scheme:pci"]
readiness = "exit"
restart = "never"
max_restarts = 0
