# vfsd snapshots the visible scheme names when its process is created; the root mount at /root
# needs ufs: in that snapshot, so the filesystem server is an explicit dependency.
name = "vfsd"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd", "nulld", "zerod", "randd", "scheme:ufs"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "on-failure"
