#
# The default file namespace. One absolute mount point followed by the scheme
# that owns it. /tmp is the dedicated 1777 tmpfs ramfs instance; all other
# ramfs mounts (for example /etc in the test profiles) keep the 0755 ramfs.

/ initfs:
/tmp tmpfs:
/dev/null null:
/dev/zero zero:
/dev/random rand:
/dev/urandom rand:
/dev/pts pty:
