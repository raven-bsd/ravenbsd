# Start after the driver has registered `nic:` so the B39 ring can be mapped.
name = "netd"
exec = "/sbin/netd"
args = ["netd", "nic"]
needs = ["logd", "scheme:nic", "scheme:initfs"]
provides = ["scheme:net"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
