# vfsd for the bootstrap: fsd-ufs must register ufs: before vfsd starts. The service
# is named vfsd so the release rc.conf's vfsd override applies.

name = "vfsd"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd", "nulld", "zerod", "randd", "scheme:ufs"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
