# The test profile runs the driver in persistent `serve` mode. `scheme:nic` is the readiness
# gate, so netd starts only after the driver has registered `nic:`.
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:nic", "scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
