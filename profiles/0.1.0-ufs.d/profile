#
# K414: interactive server login profile. Colours are on by default on a TTY;
# NO_COLOR, TERM=dumb and a non-interactive shell stay plain. The visible prompt
# keeps the `raven# ` text used by the serial transcripts.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
HOME=/root
if [ "${TERM:-}" = "dumb" ]; then
    TERM=dumb
else
    TERM=xterm-256color
fi
USER=root
LOGNAME=root
SHELL=/bin/brush
PS1='\[\e[38;5;183m\]raven# \[\e[0m\]'
RAVEN_PROFILE=loaded
export PATH HOME TERM USER LOGNAME SHELL PS1 RAVEN_PROFILE
umask 022

if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "dumb" ]; then
    CLICOLOR=0
    LS_COLORS=
    GREP_COLORS=
    export CLICOLOR LS_COLORS GREP_COLORS
else
    CLICOLOR=1
    LS_COLORS=${LS_COLORS:-di=1;34:ln=1;36:so=1;35:pi=33:ex=1;32:bd=1;33:cd=1;33}
    GREP_COLORS=${GREP_COLORS:-mt=01;31:ms=01;32:mc=01;33:fn=35:ln=32:bn=32:se=36}
    export CLICOLOR LS_COLORS GREP_COLORS
fi

complete -W 'help exit' raven-test || true

if [ -r /etc/brush/brushrc ]; then
    . /etc/brush/brushrc
fi

case $- in
    *i*)
        if [ "${CLICOLOR:-0}" = 1 ]; then
            alias l='ls -CF --color=auto'
            alias ll='ls -lah --color=auto'
            alias ls='ls --color=auto'
            alias grep='grep --color=auto'
        else
            alias l='ls -CF --color=never'
            alias ll='ls -lah --color=never'
            alias ls='ls --color=never'
            alias grep='grep --color=never'
        fi
        ;;
esac
