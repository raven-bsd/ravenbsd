# Production devd mode: launch the matched driver once and keep it serving. B12b makes the
# virtio-net driver persistent; B12c defines how netd discovers and attaches to it.
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:dev"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
