# netd after devd has launched the persistent virtio-net service. The exact `needs` seam
# (devd service, `nic:` scheme or a devd attachment) is B12c's contract; this is the planned
# integration point.
name = "netd"
exec = "/sbin/netd"
needs = ["logd", "devd"]
provides = ["scheme:net"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
