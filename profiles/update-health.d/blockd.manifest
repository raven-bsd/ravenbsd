# blockd over the virtio-blk driver's `disk:0`.
name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 300_000
restart = "never"
max_restarts = 0

[env]
BLOCKD_DISK = "disk:0"
