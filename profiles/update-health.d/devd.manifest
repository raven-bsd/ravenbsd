# The update-health devd: launch the virtio-blk driver once and keep it serving `disk:`.
name = "devd"
exec = "/sbin/devd"
args = ["devd"]
needs = ["scheme:pci"]
provides = ["scheme:disk"]
readiness = "scheme"
ready_timeout_ms = 300_000
restart = "never"
max_restarts = 0
