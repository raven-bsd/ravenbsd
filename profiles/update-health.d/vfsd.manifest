# vfsd snapshots the visible schemes when its process is created; the root mount needs ufs: in
# that snapshot, so fsd-ufs is an explicit dependency.
name = "vfsd"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd", "nulld", "zerod", "randd", "scheme:ufs"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 300_000
restart = "never"
max_restarts = 0
