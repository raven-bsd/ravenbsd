# One-shot probe: verify the pattern partition through `block:0`, then flush (which ends the
# driver's test-serving cycle).
name = "k15-probe"
exec = "/sbin/k15-probe"
needs = ["scheme:block"]
readiness = "exit"
restart = "never"
max_restarts = 0
