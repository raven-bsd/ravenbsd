# The test instance runs the matched driver for two launch/exit cycles and exits when done.
# `scheme:disk` is provided by the driver devd launches; devd's readiness probe opens it after the
# driver registers the scheme, so blockd's process namespace contains `disk:`.
name = "devd"
exec = "/sbin/devd"
args = ["devd", "test"]
needs = ["scheme:pci"]
provides = ["scheme:disk"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
