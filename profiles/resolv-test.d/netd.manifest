# netd over the persistent `nic:` frame service. The driver must register the
# scheme first so netd can map the B39 ring before it registers `net:`.
name = "netd"
exec = "/sbin/netd"
args = ["netd", "nic"]
needs = ["logd", "scheme:nic"]
provides = ["scheme:net"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
