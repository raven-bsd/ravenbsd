# Phase 1: static override plus the loopback DNS fixture.
name = "b15-resolv-probe"
exec = "/sbin/b15-resolv-probe"
args = ["b15-resolv-probe", "phase1"]
needs = ["scheme:resolv", "b15-dnsd"]
readiness = "exit"
restart = "never"
max_restarts = 0
