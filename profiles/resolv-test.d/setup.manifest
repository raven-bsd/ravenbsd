# Writes the static nameserver override used by phase 1.
name = "b15-resolv-setup"
exec = "/sbin/b15-resolv-probe"
args = ["b15-resolv-probe", "setup"]
needs = ["scheme:file"]
readiness = "exit"
restart = "never"
max_restarts = 0
