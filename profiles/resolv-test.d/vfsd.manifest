# Test-only vfsd: it needs only the schemes required for `/etc` and `/`.
# The mount table gives `/etc` a writable ramfs so resolvd can publish the
# lease-derived `/etc/resolv.conf`.
name = "vfsd"
exec = "/sbin/vfsd"
needs = ["logd", "initfsd", "ramfsd"]
provides = ["scheme:file"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
