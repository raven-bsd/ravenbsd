# Phase 2: read the lease-written `/etc/resolv.conf` and resolve through the
# lease DNS server over QEMU user networking.
name = "b15-resolv-probe2"
exec = "/sbin/b15-resolv-probe"
args = ["b15-resolv-probe", "phase2"]
needs = ["b15-resolv-restart", "scheme:resolv"]
readiness = "exit"
restart = "never"
max_restarts = 0
