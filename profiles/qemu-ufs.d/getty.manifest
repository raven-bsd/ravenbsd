#
# K234: the UFS demo keeps a console getty alive. Unlike the release gate
# (one-shot test-exit), a normal shell exit must respawn getty, not end init.

name = "getty"
exec = "/bin/getty"
needs = ["consd", "vfsd", "ramfsd", "initfsd", "scheme:net", "scheme:pty"]
restart = "always"
restart_delay_ms = 200
max_restarts = 1000
grants = ["initfs"]
