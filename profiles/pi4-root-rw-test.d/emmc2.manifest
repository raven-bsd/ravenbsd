# Host-backed EMMC2 fake card. It loads the GPT+UFS image from initfs and serves `disk:`.
name = "emmc2"
exec = "/sbin/emmc2"
args = ["test", "persist", "disk=initfs:/etc/pi4-root.img"]
needs = ["logd", "scheme:initfs"]
provides = ["scheme:disk"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
required = true
