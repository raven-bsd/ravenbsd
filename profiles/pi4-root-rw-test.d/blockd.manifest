# blockd over the EMMC2 driver's disk:0. The GPT prefix is read in 128-sector chunks.
name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0

[env]
BLOCKD_DISK = "disk:0"
