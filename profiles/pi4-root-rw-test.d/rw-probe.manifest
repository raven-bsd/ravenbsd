# One-shot write/unmount/remount probe for the read-write UFS root.
name = "fsd-ufs-rw-probe"
exec = "/sbin/fsd-ufs-rw-probe"
needs = ["scheme:ufs", "scheme:file"]
readiness = "exit"
restart = "never"
max_restarts = 0
