#
# RavenBSD brush interactive rc. The service starts brush with
# `--rcfile /etc/brush/brushrc`; non-interactive `brush -c` does not load it.

# The default interactive look is bobtheshell. Images that do not stage it keep the
# previous flat Raven Violet prompt; RAVEN_PROMPT=plain/NO_COLOR/dumb are handled there too.
if [ -r /etc/brush/bobtheshell.sh ]; then
    . /etc/brush/bobtheshell.sh
elif [ -n "${NO_COLOR:-}" ] || [ "${TERM:-}" = "dumb" ]; then
    PS1='\u@\h:\w\$ '
else
    PS1='\[\e[38;5;183m\]\u@\h\[\e[0m\]:\[\e[38;5;231m\]\w\[\e[0m\]\[\e[38;5;183m\]\$\[\e[0m\] '
fi

# A writable, image-local history store; the initfs itself is read-only.
HISTFILE=/tmp/brush_history
HISTCONTROL=ignoreboth
HISTTIMEFORMAT='%F %T '
HISTSIZE=1000
HISTFILESIZE=1000

# Command and path completion are brush defaults. The probe below proves the completion
# builtin and gives the qtest a stable spec; no foreign completion framework is loaded.
complete -W 'help exit' raven-test || true
