#
# S98 disk-tools blockd: enabled at boot so its `block:` scheme is in the login shell's namespace.
# It waits for the virtio-blk driver's disk:0 and does not gate getty; without a scratch disk the
# service simply stays waiting and the release boot is unchanged.

name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
enable = true

[env]
BLOCKD_DISK = "disk:0"
