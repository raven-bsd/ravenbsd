#
# S98 disk-tools blockd: disabled at boot. svcd rejects a service whose `needs` includes
# `scheme:disk` because the driver registers it later, and a scheme registered after the login
# shell is invisible to it (the shell namespace is snapshotted at process creation). The QEMU
# disk case is blocked on an svcd/service-order or late-namespace-grant change; see the report.

name = "blockd"
exec = "/sbin/blockd"
needs = ["scheme:disk"]
provides = ["scheme:block"]
readiness = "scheme"
ready_timeout_ms = 60_000
restart = "never"
max_restarts = 0
enable = false

[env]
BLOCKD_DISK = "disk:0"
