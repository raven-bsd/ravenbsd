diff --git a/compiler/rustc_target/src/spec/base/ravenbsd.rs b/compiler/rustc_target/src/spec/base/ravenbsd.rs
new file mode 100644
index 00000000..8be7f781
--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/ravenbsd.rs
@@ -0,0 +1,23 @@
+use crate::spec::{Cc, Env, LinkerFlavor, Lld, Os, PanicStrategy, RelroLevel, TargetOptions, cvs};
+
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Ravenbsd,
+        env: Env::Relibc,
+        // Phase 1 is static-only; the dynamic loader is a later milestone.
+        dynamic_linking: false,
+        families: cvs!["unix"],
+        position_independent_executables: true,
+        static_position_independent_executables: true,
+        relro_level: RelroLevel::Full,
+        // std's thread_local implementation needs TLS; ralibc will provide the block.
+        has_thread_local: true,
+        panic_strategy: PanicStrategy::Abort,
+        linker_flavor: LinkerFlavor::Gnu(Cc::No, Lld::Yes),
+        linker: Some("rust-lld".into()),
+        crt_static_default: true,
+        crt_static_respected: true,
+        crt_static_allows_dylibs: false,
+        ..Default::default()
+    }
+}
