diff --git a/compiler/rustc_target/src/spec/targets/aarch64_unknown_ravenbsd.rs b/compiler/rustc_target/src/spec/targets/aarch64_unknown_ravenbsd.rs
new file mode 100644
index 00000000..59715be1
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/aarch64_unknown_ravenbsd.rs
@@ -0,0 +1,24 @@
+use crate::spec::{Arch, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::ravenbsd::opts();
+    base.max_atomic_width = Some(128);
+    base.stack_probes = StackProbeType::Inline;
+    base.features = "+v8a".into();
+
+    Target {
+        llvm_target: "aarch64-unknown-none".into(),
+        metadata: TargetMetadata {
+            description: Some("RavenBSD AArch64".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
+                .into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/riscv64gc_unknown_ravenbsd.rs b/compiler/rustc_target/src/spec/targets/riscv64gc_unknown_ravenbsd.rs
new file mode 100644
index 00000000..21616b52
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/riscv64gc_unknown_ravenbsd.rs
@@ -0,0 +1,25 @@
+use crate::spec::{Arch, CodeModel, LlvmAbi, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::ravenbsd::opts();
+    base.code_model = Some(CodeModel::Medium);
+    base.cpu = "generic-rv64".into();
+    base.features = "+m,+a,+f,+d,+c".into();
+    base.llvm_abiname = LlvmAbi::Lp64d;
+    base.plt_by_default = false;
+    base.max_atomic_width = Some(64);
+
+    Target {
+        llvm_target: "riscv64-unknown-none-elf".into(),
+        metadata: TargetMetadata {
+            description: Some("RavenBSD RISC-V 64".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128".into(),
+        arch: Arch::RiscV64,
+        options: base,
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/x86_64_unknown_ravenbsd.rs b/compiler/rustc_target/src/spec/targets/x86_64_unknown_ravenbsd.rs
new file mode 100644
index 00000000..ed90f149
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_unknown_ravenbsd.rs
@@ -0,0 +1,25 @@
+use crate::spec::{Arch, Cc, LinkerFlavor, Lld, StackProbeType, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::ravenbsd::opts();
+    base.cpu = "x86-64".into();
+    base.plt_by_default = false;
+    base.max_atomic_width = Some(64);
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-m64"]);
+    base.stack_probes = StackProbeType::Inline;
+
+    Target {
+        llvm_target: "x86_64-unknown-none".into(),
+        metadata: TargetMetadata {
+            description: Some("RavenBSD x86-64".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: base,
+    }
+}
