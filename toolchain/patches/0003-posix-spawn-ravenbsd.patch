# K91/P9c: select std's posix_spawn path on x86_64-unknown-ravenbsd, declare the
# target libc ABI it calls, align sigset_t with the 128-byte runtime ABI and order
# sigaction as the 152-byte C ABI (handler, mask, flags, restorer).
# Applies after 0001-add-ravenbsd-targets.patch and 0002-libc-ravenbsd.patch.
--- a/library/std/src/sys/process/unix/unix.rs
+++ b/library/std/src/sys/process/unix/unix.rs
@@ -426,6 +426,7 @@
         target_os = "nto",
         target_vendor = "apple",
         target_os = "cygwin",
+        target_os = "ravenbsd",
     )))]
     fn posix_spawn(
         &mut self,
@@ -445,6 +446,7 @@
         target_os = "nto",
         target_vendor = "apple",
         target_os = "cygwin",
+        target_os = "ravenbsd",
     ))]
     fn posix_spawn(
         &mut self,
@@ -596,7 +598,7 @@
         /// Some platforms can set a new working directory for a spawned process in the
         /// `posix_spawn` path. This function looks up the function pointer for adding
         /// such an action to a `posix_spawn_file_actions_t` struct.
-        #[cfg(not(any(all(target_os = "linux", target_env = "musl"), target_os = "cygwin")))]
+        #[cfg(not(any(all(target_os = "linux", target_env = "musl"), target_os = "cygwin", target_os = "ravenbsd")))]
         fn get_posix_spawn_addchdir() -> Option<PosixSpawnAddChdirFn> {
             use crate::sys::weak::weak;
 
@@ -632,7 +634,7 @@
         /// of the symbol at compile time or know about it upfront.
         ///
         /// Cygwin doesn't support weak symbol, so just link it.
-        #[cfg(any(all(target_os = "linux", target_env = "musl"), target_os = "cygwin"))]
+        #[cfg(any(all(target_os = "linux", target_env = "musl"), target_os = "cygwin", target_os = "ravenbsd"))]
         fn get_posix_spawn_addchdir() -> Option<PosixSpawnAddChdirFn> {
             // Our minimum required musl supports this function, so we can just use it.
