+        pub sc_r8: c_long,
+        pub sc_r9: c_long,
+        pub sc_r10: c_long,
+        pub sc_r11: c_long,
+        pub sc_r12: c_long,
+        pub sc_r13: c_long,
+        pub sc_r14: c_long,
+        pub sc_r15: c_long,
+        pub sc_rbp: c_long,
+        pub sc_rbx: c_long,
+        pub sc_rax: c_long,
+        pub sc_gs: c_long,
+        pub sc_fs: c_long,
+        pub sc_es: c_long,
+        pub sc_ds: c_long,
+        pub sc_trapno: c_long,
