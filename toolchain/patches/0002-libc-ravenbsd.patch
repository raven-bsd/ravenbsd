+f! {
+    pub fn FD_ISSET(fd: c_int, set: *const fd_set) -> bool {
+        let set = &*set;
+        let n = set.__nfds;
+        return set.__fds[..n].iter().any(|p| *p == fd);
+    }
+
+    pub fn FD_SET(fd: c_int, set: *mut fd_set) -> () {
+        let set = &mut *set;
+        let n = set.__nfds;
+        if !set.__fds[..n].iter().any(|p| *p == fd) {
+            set.__nfds = n + 1;
+            set.__fds[n] = fd;
+        }
+    }
+
+    pub fn FD_ZERO(set: *mut fd_set) -> () {
+        (*set).__nfds = 0;
+        return;
+    }
+}
