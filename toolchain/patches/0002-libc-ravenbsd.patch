+        }
+        (*(self as *const siginfo_t).cast::<siginfo_sigfault>()).si_addr
+    }
+
+    pub unsafe fn si_value(&self) -> crate::sigval {
+        #[repr(C)]
+        struct siginfo_timer {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            _si_tid: c_int,
+            _si_overrun: c_int,
+            si_sigval: crate::sigval,
+        }
+        (*(self as *const siginfo_t).cast::<siginfo_timer>()).si_sigval
+    }
+}
