+
+// pub const _PATH_UTMPX: &[c_char; 14] = b"/var/run/utmpx";
+// pub const _PATH_WTMPX: &[c_char; 14] = b"/var/log/wtmpx";
+// pub const _PATH_LASTLOGX: &[c_char; 17] = b"/var/log/lastlogx";
