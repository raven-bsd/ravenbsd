#
# The version-node chain of ravenlibc (doc 14 3.A.7). `RAVENprivate_1.0` is never incremented;
# a new public node moves its dependency to the new node.

RAVEN_1.0 { };
RAVENprivate_1.0 { } RAVEN_1.0;
